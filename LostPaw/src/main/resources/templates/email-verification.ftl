<!DOCTYPE html>
<html>
<head>
<title>Email Verification</title>
</head>
<body>
<table role="presentation" width="100%" cellspacing="0" cellpadding="0">
      <tr>
        <td>
          <img src="cid:backgroundImage" alt="Background" width="100%" style="display: block; pointer-events: none; user-select: none; object-fit: cover;" />
        </td>
      </tr>
      <tr>
        <td style="text-align: center; padding: 20px; font-family: Arial, sans-serif;">
          <h2>Verificiraj mail </h2>
          <p style="font-size: 15px">
            Zahvaljujemo na registraciji! Molimo kliknite gumb da biste verificirali Vaš email:
          </p>

          <a href="${verificationUrl}" style="
                background-color: #8f220f;
                color: white;
                padding: 12px 20px;
                text-decoration: none;
                border-radius: 5px;
                font-size: 16px;
                display: inline-block;">
            Verificiraj email
          </a>
        </td>
      </tr>

    <tr>
        <td align="center" style="background-color: #eeeeee; padding: 20px; font-size: 12px; color: #666;">
            &copy; ${year} Izgubljene šapice. Sva prava pridržana.
        </td>
    </tr>
    </table>
  </body>
</html>
